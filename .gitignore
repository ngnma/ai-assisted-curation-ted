cat > .gitignore << 'EOF'
# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Data: TED licence (CC BY-NC-ND) forbids redistribution
data/*
!data/splits/
data/splits/*
!data/splits/.gitkeep
!data/splits/*.txt

# Experiments, secrets, OS
mlruns/
mlartifacts/
.env
kaggle.json
.DS_Store
EOF


docs/QUADRA_AI_project.md
